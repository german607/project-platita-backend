# Variables de entorno de Platita para desarrollo local.
# Copiá este archivo a `.env` (el `.env` NUNCA se sube al repo).
#
# Requisitos: Node 22 (`nvm use`) y Postgres (`docker compose up -d`).

# --- Base de datos y servidor -------------------------------------------------
DATABASE_URL="postgresql://platita:platita@localhost:5432/platita"
# El 3000 suele estar ocupado en esta máquina; el front de desarrollo apunta al 3001.
PORT=3001
# Orígenes del frontend que pueden llamar a la API desde el navegador (separados
# por coma). Vacío = sin CORS.
CORS_ORIGINS=http://localhost:5173

# --- Ingreso por código -------------------------------------------------------
# En local el proveedor es "dev": cualquier teléfono entra con el código 000000,
# no se manda ningún mensaje y no cuesta nada.
OTP_PROVIDER=dev
OTP_CHANNEL=sms

# --- Probar un SMS REAL con tu número (opcional) ------------------------------
# Con OTP_PROVIDER=dev, los teléfonos de OTP_REAL_PHONES (separados por coma, en
# cualquier formato uruguayo) pasan SIEMPRE por Twilio: reciben el SMS y 000000
# NO les sirve. El resto sigue entrando con 000000. Hace falta una cuenta de
# Twilio con un servicio de Verify (con códigos de 6 dígitos) y, en la cuenta de
# prueba, tu número verificado. Descomentá y completá las cuatro:
# OTP_REAL_PHONES=099123456
# TWILIO_ACCOUNT_SID=AC...
# TWILIO_AUTH_TOKEN=...
# TWILIO_VERIFY_SID=VA...
# TWILIO_LOCALE=es
#
# Para usar Twilio con TODOS los teléfonos (no es el modo local), poné
# OTP_PROVIDER=twilio y no uses OTP_REAL_PHONES. Las credenciales NUNCA van en el
# código ni en el repo.

# --- Rutas sin verificación (solo desarrollo) ---------------------------------
# /users/* identifica solo con el teléfono. Activas por defecto fuera de
# producción; se apagan en producción.
# INSECURE_USER_ROUTES=false
